# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# =========================================================================
# โรงพยาบาลสามชุก - ตั้งค่าเชื่อมต่อ 2 ฐานข้อมูล MySQL
# =========================================================================

# 1. ฐานข้อมูลระบบลงเวลาและสแกนนิ้ว (samchuk_attendance)
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="sa"
DB_PASSWORD=""
DB_NAME="samchuk_attendance"

# 2. ฐานข้อมูลบุคลากร HosOffice / HOSxP (hosoffice)
HOSOFFICE_HOST="localhost"
HOSOFFICE_PORT="3306"
HOSOFFICE_USER="sa"
HOSOFFICE_PASSWORD=""
HOSOFFICE_DB="hosoffice"

# 3. พอร์ต Backend API Service (พอร์ต 3005 เพื่อไม่ให้ชนกับระบบจัดซื้อ Procurement บนพอร์ต 3002)
API_PORT="3005"
VITE_API_URL="http://localhost:3005"
