# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# =========================================================================
# โรงพยาบาลสามชุก - ตั้งค่าเชื่อมต่อ 2 ฐานข้อมูล MySQL
# =========================================================================

# 1. ฐานข้อมูลระบบลงเวลาและสแกนนิ้ว (samchuk_attendance)
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="sa"
DB_PASSWORD=""
DB_NAME="samchuk_attendance"

# 2. ฐานข้อมูลบุคลากร HosOffice / HOSxP (hosoffice)
HOSOFFICE_HOST="localhost"
HOSOFFICE_PORT="3306"
HOSOFFICE_USER="sa"
HOSOFFICE_PASSWORD=""
HOSOFFICE_DB="hosoffice"

# 3. พอร์ต Central Backend API Gateway (พอร์ต 3002 รวมศูนย์)
API_PORT="3002"
VITE_API_URL=""

# 4. เขตเวลา และ ตัวอ่าน C# Standalone CLI (ScannerSyncCli.exe)
TZ="Asia/Bangkok"
SCAN_READER_EXE="backend/ScannerSyncCli.exe"

# 5. ความปลอดภัย CORS และ Token (รองรับ Localhost, LAN IP 192.168.*, 10.* และ API Gateway)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3002"
JWT_SECRET="YOUR_RANDOM_SECRET_KEY_FOR_SAMCHUK_ATTENDANCE"

